[
  {
    "id": "struct_dr",
    "tex": "\\frac{dr}{dm} = \\frac{1}{4\\pi r^2 \\rho}"
  },
  {
    "id": "struct_dp",
    "tex": "\\frac{dP}{dm} = -\\frac{G m}{4\\pi r^4}"
  },
  {
    "id": "struct_dl",
    "tex": "\\frac{dL}{dm} = \\varepsilon = \\varepsilon_{pp} + \\varepsilon_{\\mathrm{CNO}} + \\varepsilon_{3\\alpha}"
  },
  {
    "id": "struct_dt",
    "tex": "\\frac{dT}{dm} = -\\frac{G m T}{4\\pi r^4 P}\\,\\nabla, \\qquad \\nabla \\equiv \\frac{d\\ln T}{d\\ln P}"
  },
  {
    "id": "eos_p",
    "tex": "P = P_{\\mathrm{gas}} + P_{\\mathrm{rad}} = \\frac{\\rho\\, k\\, T}{\\mu\\, m_u} + \\frac{a T^4}{3}"
  },
  {
    "id": "eos_mu",
    "tex": "\\frac{1}{\\mu} = 2X + \\frac{3}{4}\\,Y + \\frac{1}{2}\\,Z"
  },
  {
    "id": "eos_beta",
    "tex": "\\beta = \\frac{P_{\\mathrm{gas}}}{P}, \\qquad \\delta = -\\left(\\frac{\\partial \\ln\\rho}{\\partial \\ln T}\\right)_{\\!P} = \\frac{4 - 3\\beta}{\\beta}"
  },
  {
    "id": "eos_cp",
    "tex": "c_P = \\frac{k}{\\mu\\, m_u}\\left[\\frac{3}{2} + \\frac{12\\,(1-\\beta)}{\\beta} + \\frac{(4 - 3\\beta)^2}{\\beta^2}\\right]"
  },
  {
    "id": "eos_nabla_ad",
    "tex": "\\nabla_{\\mathrm{ad}} = \\left(\\frac{\\partial \\ln T}{\\partial \\ln P}\\right)_{\\!s} = \\frac{2\\,(4 - 3\\beta)}{32 - 24\\beta - 3\\beta^2}"
  },
  {
    "id": "kap_es",
    "tex": "\\kappa_{\\mathrm{es}} = 0.2\\,(1 + X)"
  },
  {
    "id": "kap_ff",
    "tex": "\\kappa_{\\mathrm{ff}} = 3.68\\times10^{22}\\,(1 - Z)(1 + X)\\,\\rho\\,T^{-3.5}"
  },
  {
    "id": "kap_bf",
    "tex": "\\kappa_{\\mathrm{bf}} = \\frac{4.34\\times10^{25}}{t}\\,Z\\,(1 + X)\\,\\rho\\,T^{-3.5}, \\qquad t = 2.82\\,\\bigl[\\rho\\,(1 + X)\\bigr]^{0.2}"
  },
  {
    "id": "kap_hm",
    "tex": "\\kappa_{\\mathrm{H}^-} = 2.5\\times10^{-31}\\,\\frac{Z}{0.02}\\,\\rho^{1/2}\\,T^{9}"
  },
  {
    "id": "kap_mol",
    "tex": "\\kappa_{\\mathrm{mol}} = 0.1\\,Z"
  },
  {
    "id": "kap_total",
    "tex": "\\kappa = \\kappa_{\\mathrm{mol}} + \\left[\\frac{1}{\\kappa_{\\mathrm{H}^-}} + \\frac{1}{\\kappa_{\\mathrm{es}} + \\kappa_{\\mathrm{ff}} + \\kappa_{\\mathrm{bf}}}\\right]^{-1}"
  },
  {
    "id": "nuc_t6",
    "tex": "T_6 = \\frac{T}{10^6\\,\\mathrm{K}}, \\qquad T_8 = \\frac{T}{10^8\\,\\mathrm{K}}"
  },
  {
    "id": "nuc_pp",
    "tex": "\\varepsilon_{pp} = \\psi\\,\\varepsilon_{pp,\\mathrm{I}}, \\qquad \\varepsilon_{pp,\\mathrm{I}} = \\frac{r_{11}}{2}\\,\\frac{E_{\\mathrm{I}}}{\\rho}, \\qquad r_{11} = \\tfrac12\\, n_p^2\\, \\langle\\sigma v\\rangle_{11}\\, f_1"
  },
  {
    "id": "nuc_sigmav",
    "tex": "\\langle\\sigma v\\rangle = \\sqrt{\\frac{8}{\\pi\\mu}}\\,(kT)^{-3/2} \\int_0^\\infty S(E)\\, \\exp\\!\\left(-\\frac{E}{kT} - \\frac{b}{\\sqrt{E}}\\right) dE, \\qquad b = \\pi\\alpha_{\\mathrm{fs}} Z_1 Z_2 \\sqrt{2\\mu c^2}, \\qquad S(E) = S(0) + S'(0)\\,E + \\tfrac12 S''(0)\\,E^2"
  },
  {
    "id": "nuc_cno",
    "tex": "\\varepsilon_{\\mathrm{CNO}} = n_p\\, n_{14}\\, \\langle\\sigma v\\rangle_{1,14}\\, f_7\\, \\frac{E_{\\mathrm{CNO}}}{\\rho}"
  },
  {
    "id": "nuc_c",
    "tex": "n_p = \\frac{\\rho X}{m_{\\mathrm{H}}}, \\qquad n_{14} = \\frac{\\rho X_{\\mathrm{CNO}}}{m_{14}}, \\qquad X_{\\mathrm{CNO}} = f_{\\mathrm{CNO}}\\, Z, \\qquad E_{\\mathrm{I}} = 26.20\\ \\mathrm{MeV}, \\qquad E_{\\mathrm{CNO}} = 25.03\\ \\mathrm{MeV}"
  },
  {
    "id": "nuc_3a",
    "tex": "\\varepsilon_{3\\alpha} = 5.09\\times10^{11}\\;\\rho^2\\, Y^3\\, f_{4}\\, f_{8}\\; T_8^{-3}\\, \\exp\\!\\left(-\\frac{44.027}{T_8}\\right)"
  },
  {
    "id": "nuc_screen",
    "tex": "f_{Z_1 Z_2} = \\exp\\!\\left(0.188\\, Z_1 Z_2\\, \\zeta\\, \\rho^{1/2}\\, T_6^{-3/2}\\right), \\qquad \\zeta^2 = 2X + 1.5\\,Y + 4Z"
  },
  {
    "id": "tr_nabla_rad",
    "tex": "\\nabla_{\\mathrm{rad}} = \\frac{3\\,\\kappa\\, L\\, P}{16\\pi\\, a\\, c\\, G\\, m\\, T^4}"
  },
  {
    "id": "tr_schwarzschild",
    "tex": "\\nabla_{\\mathrm{rad}} > \\nabla_{\\mathrm{ad}} \\;\\Rightarrow\\; \\text{convective}, \\qquad \\nabla_{\\mathrm{rad}} \\le \\nabla_{\\mathrm{ad}} \\;\\Rightarrow\\; \\text{radiative},\\; \\nabla = \\nabla_{\\mathrm{rad}}"
  },
  {
    "id": "mlt_defs",
    "tex": "g = \\frac{G m}{r^2}, \\qquad H_P = \\frac{P}{\\rho\\, g}, \\qquad \\ell = \\alpha_{\\mathrm{MLT}}\\, \\min\\!\\left(H_P,\\ \\sqrt{\\frac{P}{G\\rho^2}}\\right)"
  },
  {
    "id": "mlt_u",
    "tex": "U = \\frac{3\\, a\\, c\\, T^3}{c_P\\, \\rho^2\\, \\kappa\\, \\ell^2}\\sqrt{\\frac{8 H_P}{g\\, \\delta}}, \\qquad W = \\nabla_{\\mathrm{rad}} - \\nabla_{\\mathrm{ad}}"
  },
  {
    "id": "mlt_cubic",
    "tex": "(\\xi - U)^3 + \\frac{8U}{9}\\left(\\xi^2 - U^2 - W\\right) = 0"
  },
  {
    "id": "mlt_nabla",
    "tex": "\\nabla = \\nabla_{\\mathrm{ad}} + \\eta\\,(\\eta + 2U), \\qquad \\eta = \\xi - U \\ge 0"
  },
  {
    "id": "mlt_v",
    "tex": "v_{\\mathrm{conv}} = \\eta\\, \\ell \\sqrt{\\frac{g\\, \\delta}{8 H_P}}"
  },
  {
    "id": "mlt_fconv",
    "tex": "\\frac{F_{\\mathrm{conv}}}{F} = \\frac{\\nabla_{\\mathrm{rad}} - \\nabla}{\\nabla_{\\mathrm{rad}}}"
  },
  {
    "id": "bc_centre",
    "tex": "r_0 = \\left(\\frac{3\\, m_0}{4\\pi\\, \\rho_0}\\right)^{1/3}, \\qquad L_0 = \\varepsilon_0\\, m_0, \\qquad m_0 = 10^{-6} M"
  },
  {
    "id": "bc_eddington",
    "tex": "T^4(\\tau) = \\frac{3}{4}\\, T_{\\mathrm{eff}}^4 \\left(\\tau + \\frac{2}{3}\\right)"
  },
  {
    "id": "bc_lum",
    "tex": "L = 4\\pi R^2 \\sigma T^4 \\qquad (T = T_{\\mathrm{eff}} \\text{ at } \\tau = \\tfrac{2}{3})"
  },
  {
    "id": "bc_pressure",
    "tex": "P = \\frac{2}{3}\\, \\frac{G M}{R^2\\, \\kappa} + \\frac{a\\, T_{\\mathrm{eff}}^4}{6}"
  },
  {
    "id": "num_mesh",
    "tex": "s(q) = a \\ln q + b\\, q - c \\ln\\!\\left(1 - q + 10^{-12}\\right), \\qquad q = \\frac{m}{M}"
  },
  {
    "id": "num_unknowns",
    "tex": "\\mathbf{y}_k = \\left(\\ln r_k,\\; \\ln P_k,\\; \\ln T_k,\\; L_k / L_{\\mathrm{scale}}\\right), \\qquad k = 0, \\dots, N-1"
  },
  {
    "id": "num_difference",
    "tex": "\\mathbf{y}_{k+1} - \\mathbf{y}_k = \\left(m_{k+1} - m_k\\right)\\, \\mathbf{f}\\!\\left(\\frac{m_k + m_{k+1}}{2},\\; \\frac{\\mathbf{y}_k + \\mathbf{y}_{k+1}}{2}\\right)"
  },
  {
    "id": "num_newton",
    "tex": "\\mathsf{J}\\, \\delta\\mathbf{y} = -\\mathbf{F}(\\mathbf{y}), \\qquad \\mathbf{y} \\leftarrow \\mathbf{y} + \\lambda\\, \\delta\\mathbf{y}, \\qquad \\lambda = \\min\\!\\left(1,\\; \\min_j \\frac{\\Delta_j^{\\max}}{\\max_k |\\delta y_{k,j}|}\\right)"
  },
  {
    "id": "num_jacobian",
    "tex": "\\mathsf{J}_{ij} = \\frac{\\partial F_i}{\\partial y_j} \\approx \\frac{F_i(\\mathbf{y} + h\\,\\mathbf{e}_j) - F_i(\\mathbf{y} - h\\,\\mathbf{e}_j)}{2h}, \\qquad h = 10^{-6}"
  },
  {
    "id": "res_teff",
    "tex": "L = 4\\pi R^2 \\sigma T_{\\mathrm{eff}}^4, \\qquad \\log g = \\log_{10} \\frac{G M}{R^2}"
  },
  {
    "id": "res_virial",
    "tex": "\\frac{\\displaystyle\\int_0^M \\frac{3P}{\\rho}\\, dm}{\\displaystyle\\int_0^M \\frac{G m}{r}\\, dm} = 1 \\qquad \\text{(virial theorem)}"
  },
  {
    "id": "res_energy",
    "tex": "\\frac{\\displaystyle\\int_{m_0}^M \\varepsilon\\, dm + L_0}{L} = 1 \\qquad \\text{(energy conservation)}"
  },
  {
    "id": "init_lane_emden",
    "tex": "\\frac{1}{\\xi^2}\\frac{d}{d\\xi}\\left(\\xi^2 \\frac{d\\theta}{d\\xi}\\right) = -\\theta^n, \\qquad \\theta(0) = 1,\\; \\theta'(0) = 0, \\qquad n = 3"
  },
  {
    "id": "init_homology",
    "tex": "\\frac{R}{R_\\odot} \\approx \\begin{cases} 0.89\\, M^{0.8} & M < 1.3 \\\\ 0.89 \\cdot 1.3^{0.8}\\, (M/1.3)^{0.6} & M \\ge 1.3 \\end{cases} \\qquad \\frac{L}{L_\\odot} \\approx \\begin{cases} 0.7\\, M^{4.5} & M < 2 \\\\ 0.7 \\cdot 2^{4.5}\\, (M/2)^{3.5} & M \\ge 2 \\end{cases}"
  },
  {
    "id": "init_central",
    "tex": "\\rho_c = 54.18\\, \\bar\\rho, \\qquad P_c = 11.05\\, \\frac{G M^2}{R^4}, \\qquad \\rho = \\rho_c\\, \\theta^3, \\quad P = P_c\\, \\theta^4"
  },
  {
    "id": "init_envelope",
    "tex": "P_{\\mathrm{env}}(m) = \\frac{G M\\, (M - m)}{4\\pi R^4} + P_{\\mathrm{ph}}"
  },
  {
    "id": "init_scaling",
    "tex": "R \\propto M^{0.75}, \\qquad P \\propto M^{-1}, \\qquad T \\propto M^{0.25}, \\qquad L \\propto M^{3.5}"
  },
  {
    "id": "evo_burn_h",
    "tex": "\\frac{\\partial X}{\\partial t} = -\\frac{\\varepsilon_{pp}}{Q_{pp}^{\\mathrm{eff}}} - \\frac{\\varepsilon_{\\mathrm{CNO}}}{Q_{\\mathrm{CNO}}}, \\qquad Q_{pp}^{\\mathrm{eff}} = 6.27\\times10^{18}\\,\\left(1 - 0.021\\,F_{\\mathrm{II}}\\right), \\qquad Q_{\\mathrm{CNO}} = 5.99\\times10^{18}\\ \\mathrm{erg\\,g^{-1}}"
  },
  {
    "id": "evo_burn_he",
    "tex": "\\frac{\\partial Y}{\\partial t} = -\\frac{\\partial X}{\\partial t} - \\frac{\\varepsilon_{3\\alpha}}{Q_{\\mathrm{He}}}, \\qquad \\frac{\\partial Z}{\\partial t} = \\frac{\\varepsilon_{3\\alpha}}{Q_{\\mathrm{He}}}, \\qquad Q_{\\mathrm{He}} = 5.85\\times10^{17}\\ \\mathrm{erg\\,g^{-1}}"
  },
  {
    "id": "evo_mix",
    "tex": "X \\;\\leftarrow\\; \\bar X_{\\mathrm{zone}} = \\frac{\\int_{\\mathrm{zone}} X\\, dm}{\\int_{\\mathrm{zone}} dm} \\qquad \\text{(same for } Y, Z\\text{) in every convective zone}"
  },
  {
    "id": "evo_egrav",
    "tex": "\\varepsilon_{\\mathrm{grav}} = -T\\frac{ds}{dt} = -c_P T\\left(\\frac{d\\ln T}{dt} - \\nabla_{\\mathrm{ad}}\\frac{d\\ln P}{dt}\\right) \\approx -\\frac{c_P T}{\\Delta t}\\left(\\Delta\\ln T - \\nabla_{\\mathrm{ad}}\\,\\Delta\\ln P\\right)"
  },
  {
    "id": "evo_dl",
    "tex": "\\frac{dL}{dm} = \\varepsilon_{\\mathrm{nuc}} + \\varepsilon_{\\mathrm{grav}}"
  },
  {
    "id": "evo_dt",
    "tex": "|\\Delta X| \\le \\min\\!\\left(0.01,\\ \\max(0.3\\,X,\\ 10^{-5})\\right)\\ \\ (\\text{same for } Y \\text{ where } \\varepsilon_{3\\alpha} > 0), \\qquad \\Delta t_{\\mathrm{next}} = \\Delta t \\cdot \\min\\!\\left(2,\\ \\max\\!\\left(\\tfrac{1}{2},\\ \\frac{0.02}{\\max|\\Delta \\ln r, \\Delta\\ln P, \\Delta\\ln T, \\Delta\\ln L|}\\right)\\right)"
  },
  {
    "id": "puls_lawe",
    "tex": "\\frac{d\\xi}{dm} = -\\frac{3\\xi + p/\\Gamma_1}{4\\pi r^3\\rho}, \\qquad \\frac{dp}{dm} = \\frac{G m}{4\\pi r^4 P}\\left[\\left(4 + \\frac{\\omega^2 r^3}{G m}\\right)\\xi + p\\right], \\qquad \\xi = \\frac{\\delta r}{r},\\; p = \\frac{\\delta P}{P}"
  },
  {
    "id": "puls_bc",
    "tex": "3\\xi + \\frac{p}{\\Gamma_1} = 0 \\;\\; (\\text{centre}), \\qquad p + (4 + \\Omega^2)\\,\\xi = 0,\\;\\; \\xi = 1 \\;\\; (\\text{surface}), \\qquad \\Omega^2 = \\frac{\\omega^2 R^3}{G M}"
  },
  {
    "id": "puls_gamma1",
    "tex": "\\Gamma_1 = \\left(\\frac{\\partial\\ln P}{\\partial\\ln\\rho}\\right)_{\\!s} = \\frac{32 - 24\\beta - 3\\beta^2}{24 - 21\\beta}"
  },
  {
    "id": "puls_period",
    "tex": "\\Pi = \\frac{2\\pi}{\\omega}, \\qquad Q = \\Pi\\,\\sqrt{\\frac{\\bar\\rho}{\\bar\\rho_\\odot}}"
  },
  {
    "id": "puls_strip",
    "tex": "\\log T_{\\mathrm{blue}} = 3.94 - 0.037\\,(\\log L - 0.5), \\qquad \\log T_{\\mathrm{red}} = 3.80 - 0.023\\,(\\log L - 0.5), \\qquad \\log L \\ge 0.3"
  },
  {
    "id": "puls_homogeneous",
    "tex": "\\Omega^2 = 3\\Gamma_1 - 4 \\qquad \\text{(uniform-density sphere, } \\xi = \\text{const)}"
  },
  {
    "id": "seis_scaling",
    "tex": "\\nu_{\\max} = 3090\\,\\mu\\mathrm{Hz}\\;\\frac{g}{g_\\odot}\\left(\\frac{T_{\\mathrm{eff}}}{T_{\\mathrm{eff},\\odot}}\\right)^{-1/2}, \\qquad \\Delta\\nu = 135.1\\,\\mu\\mathrm{Hz}\\,\\sqrt{\\frac{\\bar\\rho}{\\bar\\rho_\\odot}}"
  },
  {
    "id": "evo_budget",
    "tex": "\\sum_{\\mathrm{steps}} Q_{\\mathrm{H}}^{\\mathrm{eff}}\\,\\Delta\\!\\left[\\int X\\, dm\\right] \\approx \\int_0^t L\\, dt', \\qquad Q_{\\mathrm{H}}^{\\mathrm{eff}} = \\frac{\\int (\\varepsilon_{pp} + \\varepsilon_{\\mathrm{CNO}})\\,dm}{\\int \\left(\\varepsilon_{pp}/Q_{pp}^{\\mathrm{eff}} + \\varepsilon_{\\mathrm{CNO}}/Q_{\\mathrm{CNO}}\\right) dm}"
  },
  {
    "id": "evo_overshoot",
    "tex": "r_{\\mathrm{ov}} = r_{\\mathrm{cc}} + \\alpha_{\\mathrm{ov}}\\,\\min\\!\\left(H_P(r_{\\mathrm{cc}}),\\ r_{\\mathrm{cc}}\\right)"
  },
  {
    "id": "seis_cs_lamb",
    "tex": "c_s^2 = \\frac{\\Gamma_1 P}{\\rho}, \\qquad S_l^2 = \\frac{l(l+1)\\,c_s^2}{r^2}"
  },
  {
    "id": "seis_n2",
    "tex": "N^2 = \\frac{g^2 \\rho}{P}\\left[\\delta\\left(\\nabla_{\\mathrm{ad}} - \\nabla\\right) + \\varphi\\,\\nabla_\\mu\\right], \\qquad \\nabla_\\mu = \\frac{d\\ln\\mu}{d\\ln P}, \\qquad \\varphi = 1"
  },
  {
    "id": "seis_asymptotic",
    "tex": "\\Delta\\nu = \\left[2\\int_0^R \\frac{dr}{c_s}\\right]^{-1}, \\qquad \\Delta\\Pi_1 = \\frac{2\\pi^2}{\\sqrt{2}}\\left[\\int_{r_1}^{r_2} N\\,\\frac{dr}{r}\\right]^{-1}"
  },
  {
    "id": "nuc_branch",
    "tex": "\\alpha = \\left(\\frac{Y}{4X}\\right)^{2} \\frac{\\langle\\sigma v\\rangle_{34}^{\\,2}}{\\langle\\sigma v\\rangle_{11}\\,\\langle\\sigma v\\rangle_{33}}, \\qquad \\phi = 1 + \\frac{2}{\\sqrt{1 + 2/\\alpha} + 1}, \\qquad F_{\\mathrm{II}} = \\frac{2\\,(\\phi - 1)}{\\phi}, \\qquad \\psi = \\phi\\,\\left(1 - 0.021\\,F_{\\mathrm{II}}\\right)"
  },
  {
    "id": "evo_zone_burn",
    "tex": "X_{\\mathrm{zone}}^{\\mathrm{new}} = \\max\\!\\left(0,\\; \\bar X_{\\mathrm{zone}} + \\langle \\dot X \\rangle_{\\mathrm{zone}}\\,\\Delta t\\right), \\qquad \\langle \\dot X \\rangle_{\\mathrm{zone}} = \\frac{\\int_{\\mathrm{zone}} \\dot X\\, dm}{\\int_{\\mathrm{zone}} dm}"
  },
  {
    "id": "evo_energy",
    "tex": "\\mathcal{R} = \\frac{\\int L\\,dt - \\int\\!\\!\\int\\varepsilon_{\\mathrm{nuc}}\\,dm\\,dt + \\Delta(E_{\\mathrm{int}} + E_{\\mathrm{grav}})}{\\int L\\,dt}, \\qquad E_{\\mathrm{int}} = \\int u\\,dm, \\qquad E_{\\mathrm{grav}} = -\\int \\frac{G m}{r}\\,dm"
  },
  {
    "id": "puls_overtones",
    "tex": "\\Omega_k^2 = \\Gamma_1\\,(k + 1)(2k + 3) - 4 \\qquad \\text{(uniform-density sphere, } k \\text{ nodes)}"
  },
  {
    "id": "puls_cutoff",
    "tex": "\\omega_{\\mathrm{ac}} = \\frac{c_s}{2 H_P} \\ \\ \\text{at the photosphere}, \\qquad \\text{flagged if } \\omega/\\omega_{\\mathrm{ac}} > 0.5"
  },
  {
    "id": "res_redshift",
    "tex": "v_z = \\frac{G M}{R\\,c} \\qquad \\text{(636 m/s for 1 M}_\\odot\\text{ at 1 R}_\\odot\\text{)}"
  },
  {
    "id": "par_helium",
    "tex": "Y = Y_p + \\frac{\\Delta Y}{\\Delta Z}\\,Z, \\qquad Y_p = 0.249, \\quad \\frac{\\Delta Y}{\\Delta Z} = 1.5, \\qquad X = 1 - Y - Z"
  }
]
