[
  { "id": "struct_dr", "tex": "\\frac{dr}{dm} = \\frac{1}{4\\pi r^2 \\rho}" },
  { "id": "struct_dp", "tex": "\\frac{dP}{dm} = -\\frac{G m}{4\\pi r^4}" },
  { "id": "struct_dl", "tex": "\\frac{dL}{dm} = \\varepsilon = \\varepsilon_{pp} + \\varepsilon_{\\mathrm{CNO}} + \\varepsilon_{3\\alpha}" },
  { "id": "struct_dt", "tex": "\\frac{dT}{dm} = -\\frac{G m T}{4\\pi r^4 P}\\,\\nabla, \\qquad \\nabla \\equiv \\frac{d\\ln T}{d\\ln P}" },

  { "id": "eos_p", "tex": "P = P_{\\mathrm{gas}} + P_{\\mathrm{rad}} = \\frac{\\rho\\, k\\, T}{\\mu\\, m_u} + \\frac{a T^4}{3}" },
  { "id": "eos_mu", "tex": "\\frac{1}{\\mu} = 2X + \\frac{3}{4}\\,Y + \\frac{1}{2}\\,Z" },
  { "id": "eos_beta", "tex": "\\beta = \\frac{P_{\\mathrm{gas}}}{P}, \\qquad \\delta = -\\left(\\frac{\\partial \\ln\\rho}{\\partial \\ln T}\\right)_{\\!P} = \\frac{4 - 3\\beta}{\\beta}" },
  { "id": "eos_cp", "tex": "c_P = \\frac{k}{\\mu\\, m_u}\\left[\\frac{3}{2} + \\frac{12\\,(1-\\beta)}{\\beta} + \\frac{(4 - 3\\beta)^2}{\\beta^2}\\right]" },
  { "id": "eos_nabla_ad", "tex": "\\nabla_{\\mathrm{ad}} = \\left(\\frac{\\partial \\ln T}{\\partial \\ln P}\\right)_{\\!s} = \\frac{2\\,(4 - 3\\beta)}{32 - 24\\beta - 3\\beta^2}" },

  { "id": "kap_es", "tex": "\\kappa_{\\mathrm{es}} = 0.2\\,(1 + X)" },
  { "id": "kap_ff", "tex": "\\kappa_{\\mathrm{ff}} = 3.68\\times10^{22}\\,(1 - Z)(1 + X)\\,\\rho\\,T^{-3.5}" },
  { "id": "kap_bf", "tex": "\\kappa_{\\mathrm{bf}} = \\frac{4.34\\times10^{25}}{t}\\,Z\\,(1 + X)\\,\\rho\\,T^{-3.5}, \\qquad t = 2.82\\,\\bigl[\\rho\\,(1 + X)\\bigr]^{0.2}" },
  { "id": "kap_hm", "tex": "\\kappa_{\\mathrm{H}^-} = 2.5\\times10^{-31}\\,\\frac{Z}{0.02}\\,\\rho^{1/2}\\,T^{9}" },
  { "id": "kap_mol", "tex": "\\kappa_{\\mathrm{mol}} = 0.1\\,Z" },
  { "id": "kap_total", "tex": "\\kappa = \\kappa_{\\mathrm{mol}} + \\left[\\frac{1}{\\kappa_{\\mathrm{H}^-}} + \\frac{1}{\\kappa_{\\mathrm{es}} + \\kappa_{\\mathrm{ff}} + \\kappa_{\\mathrm{bf}}}\\right]^{-1}" },

  { "id": "nuc_t6", "tex": "T_6 = \\frac{T}{10^6\\,\\mathrm{K}}, \\qquad T_8 = \\frac{T}{10^8\\,\\mathrm{K}}" },
  { "id": "nuc_pp", "tex": "\\varepsilon_{pp} = 2.38\\times10^{6}\\;\\rho\\, X^2\\, f_{1}\\, \\psi\\; T_6^{-2/3}\\, \\exp\\!\\left(-33.80\\, T_6^{-1/3}\\right)" },
  { "id": "nuc_psi", "tex": "\\psi = 1 + 0.0123\\, T_6^{1/3} + 0.0109\\, T_6^{2/3} + 0.0009\\, T_6" },
  { "id": "nuc_cno", "tex": "\\varepsilon_{\\mathrm{CNO}} = 8.67\\times10^{27}\\;\\rho\\, X\\, X_{\\mathrm{CNO}}\\, f_{7}\\, C\\; T_6^{-2/3}\\, \\exp\\!\\left(-152.28\\, T_6^{-1/3}\\right)" },
  { "id": "nuc_c", "tex": "C = 1 + 0.0027\\, T_6^{1/3} - 0.00778\\, T_6^{2/3} - 0.000149\\, T_6, \\qquad X_{\\mathrm{CNO}} = f_{\\mathrm{CNO}}\\, Z" },
  { "id": "nuc_3a", "tex": "\\varepsilon_{3\\alpha} = 5.09\\times10^{11}\\;\\rho^2\\, Y^3\\, f_{4}\\, f_{8}\\; T_8^{-3}\\, \\exp\\!\\left(-\\frac{44.027}{T_8}\\right)" },
  { "id": "nuc_screen", "tex": "f_{Z_1 Z_2} = \\exp\\!\\left(0.188\\, Z_1 Z_2\\, \\zeta\\, \\rho^{1/2}\\, T_6^{-3/2}\\right), \\qquad \\zeta^2 = 2X + 1.5\\,Y + 4Z" },

  { "id": "tr_nabla_rad", "tex": "\\nabla_{\\mathrm{rad}} = \\frac{3\\,\\kappa\\, L\\, P}{16\\pi\\, a\\, c\\, G\\, m\\, T^4}" },
  { "id": "tr_schwarzschild", "tex": "\\nabla_{\\mathrm{rad}} > \\nabla_{\\mathrm{ad}} \\;\\Rightarrow\\; \\text{convective}, \\qquad \\nabla_{\\mathrm{rad}} \\le \\nabla_{\\mathrm{ad}} \\;\\Rightarrow\\; \\text{radiative},\\; \\nabla = \\nabla_{\\mathrm{rad}}" },
  { "id": "mlt_defs", "tex": "g = \\frac{G m}{r^2}, \\qquad H_P = \\frac{P}{\\rho\\, g}, \\qquad \\ell = \\alpha_{\\mathrm{MLT}}\\, H_P" },
  { "id": "mlt_u", "tex": "U = \\frac{3\\, a\\, c\\, T^3}{c_P\\, \\rho^2\\, \\kappa\\, \\ell^2}\\sqrt{\\frac{8 H_P}{g\\, \\delta}}, \\qquad W = \\nabla_{\\mathrm{rad}} - \\nabla_{\\mathrm{ad}}" },
  { "id": "mlt_cubic", "tex": "(\\xi - U)^3 + \\frac{8U}{9}\\left(\\xi^2 - U^2 - W\\right) = 0" },
  { "id": "mlt_nabla", "tex": "\\nabla = \\nabla_{\\mathrm{ad}} + \\eta\\,(\\eta + 2U), \\qquad \\eta = \\xi - U \\ge 0" },
  { "id": "mlt_v", "tex": "v_{\\mathrm{conv}} = \\eta\\, \\ell \\sqrt{\\frac{g\\, \\delta}{8 H_P}}" },
  { "id": "mlt_fconv", "tex": "\\frac{F_{\\mathrm{conv}}}{F} = \\frac{\\nabla_{\\mathrm{rad}} - \\nabla}{\\nabla_{\\mathrm{rad}}}" },

  { "id": "bc_centre", "tex": "r_0 = \\left(\\frac{3\\, m_0}{4\\pi\\, \\rho_0}\\right)^{1/3}, \\qquad L_0 = \\varepsilon_0\\, m_0, \\qquad m_0 = 10^{-6} M" },
  { "id": "bc_eddington", "tex": "T^4(\\tau) = \\frac{3}{4}\\, T_{\\mathrm{eff}}^4 \\left(\\tau + \\frac{2}{3}\\right)" },
  { "id": "bc_lum", "tex": "L = 4\\pi R^2 \\sigma T^4 \\qquad (T = T_{\\mathrm{eff}} \\text{ at } \\tau = \\tfrac{2}{3})" },
  { "id": "bc_pressure", "tex": "P = \\frac{2}{3}\\, \\frac{G M}{R^2\\, \\kappa} + \\frac{a\\, T_{\\mathrm{eff}}^4}{6}" },

  { "id": "num_mesh", "tex": "s(q) = a \\ln q + b\\, q - c \\ln\\!\\left(1 - q + 10^{-12}\\right), \\qquad q = \\frac{m}{M}" },
  { "id": "num_unknowns", "tex": "\\mathbf{y}_k = \\left(\\ln r_k,\\; \\ln P_k,\\; \\ln T_k,\\; L_k / L_{\\mathrm{scale}}\\right), \\qquad k = 0, \\dots, N-1" },
  { "id": "num_difference", "tex": "\\mathbf{y}_{k+1} - \\mathbf{y}_k = \\left(m_{k+1} - m_k\\right)\\, \\mathbf{f}\\!\\left(\\frac{m_k + m_{k+1}}{2},\\; \\frac{\\mathbf{y}_k + \\mathbf{y}_{k+1}}{2}\\right)" },
  { "id": "num_newton", "tex": "\\mathsf{J}\\, \\delta\\mathbf{y} = -\\mathbf{F}(\\mathbf{y}), \\qquad \\mathbf{y} \\leftarrow \\mathbf{y} + \\lambda\\, \\delta\\mathbf{y}, \\qquad \\lambda = \\min\\!\\left(1,\\; \\min_j \\frac{\\Delta_j^{\\max}}{\\max_k |\\delta y_{k,j}|}\\right)" },
  { "id": "num_jacobian", "tex": "\\mathsf{J}_{ij} = \\frac{\\partial F_i}{\\partial y_j} \\approx \\frac{F_i(\\mathbf{y} + h\\,\\mathbf{e}_j) - F_i(\\mathbf{y} - h\\,\\mathbf{e}_j)}{2h}, \\qquad h = 10^{-6}" },

  { "id": "res_teff", "tex": "L = 4\\pi R^2 \\sigma T_{\\mathrm{eff}}^4, \\qquad \\log g = \\log_{10} \\frac{G M}{R^2}" },
  { "id": "res_virial", "tex": "\\frac{\\displaystyle\\int_0^M \\frac{3P}{\\rho}\\, dm}{\\displaystyle\\int_0^M \\frac{G m}{r}\\, dm} = 1 \\qquad \\text{(virial theorem)}" },
  { "id": "res_energy", "tex": "\\frac{\\displaystyle\\int_{m_0}^M \\varepsilon\\, dm + L_0}{L} = 1 \\qquad \\text{(energy conservation)}" },

  { "id": "init_lane_emden", "tex": "\\frac{1}{\\xi^2}\\frac{d}{d\\xi}\\left(\\xi^2 \\frac{d\\theta}{d\\xi}\\right) = -\\theta^n, \\qquad \\theta(0) = 1,\\; \\theta'(0) = 0, \\qquad n = 3" },
  { "id": "init_homology", "tex": "\\frac{R}{R_\\odot} \\approx \\begin{cases} 0.89\\, M^{0.8} & M < 1.3 \\\\ 0.89 \\cdot 1.3^{0.8}\\, (M/1.3)^{0.6} & M \\ge 1.3 \\end{cases} \\qquad \\frac{L}{L_\\odot} \\approx \\begin{cases} 0.7\\, M^{4.5} & M < 2 \\\\ 0.7 \\cdot 2^{4.5}\\, (M/2)^{3.5} & M \\ge 2 \\end{cases}" },
  { "id": "init_central", "tex": "\\rho_c = 54.18\\, \\bar\\rho, \\qquad P_c = 11.05\\, \\frac{G M^2}{R^4}, \\qquad \\rho = \\rho_c\\, \\theta^3, \\quad P = P_c\\, \\theta^4" },
  { "id": "init_envelope", "tex": "P_{\\mathrm{env}}(m) = \\frac{G M\\, (M - m)}{4\\pi R^4} + P_{\\mathrm{ph}}" },
  { "id": "init_scaling", "tex": "R \\propto M^{0.75}, \\qquad P \\propto M^{-1}, \\qquad T \\propto M^{0.25}, \\qquad L \\propto M^{3.5}" }
]
